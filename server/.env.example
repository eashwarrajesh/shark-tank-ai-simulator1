PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ── AI Mode Configuration ─────────────────────────────────────────
# Set to 'mock' for demo/testing (no API key needed)
# Set to 'huggingface' or 'openai' for real AI (API key required)
AI_MODE=mock

# ── Hugging Face API (Only needed if AI_MODE=huggingface) ─────────
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ── OpenAI / Grok API (Alternative to Hugging Face) ───────────────
# OPENAI_API_KEY=your_openai_api_key_here
# GROK_API_KEY=your_grok_api_key_here

# ── Request timeout (milliseconds) ───────────────────────────────
AI_TIMEOUT_MS=30000